<%
  const pageBody = `
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#F0FDFA,#FFF7ED);padding:2rem;">
      <div style="background:white;border-radius:20px;padding:2.5rem;width:100%;max-width:400px;box-shadow:0 8px 32px rgba(20,184,166,0.18);">
        <div style="text-align:center;margin-bottom:2rem;">
          <div style="font-size:2.5rem;margin-bottom:1rem;">🔒</div>
          <h1 style="font-size:1.5rem;font-weight:800;color:#134E4A;margin-bottom:0.5rem;">Protected Link</h1>
          <p style="font-size:0.875rem;color:#6B9E9A;">Enter the password to access this link.</p>
        </div>
        ${error ? `<div style="background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;padding:0.75rem 1rem;border-radius:6px;font-size:0.875rem;margin-bottom:1rem;">${error}</div>` : ''}
        <form method="POST" action="/${shortCode}/verify">
          <div style="margin-bottom:1rem;">
            <input type="password" name="password" placeholder="Enter password" required
              style="width:100%;background:white;border:1.5px solid #CCFBF1;border-radius:6px;padding:0.75rem 1rem;font-size:0.875rem;color:#134E4A;outline:none;" />
          </div>
          <button type="submit"
            style="width:100%;background:#14B8A6;color:white;border:none;border-radius:9999px;padding:0.875rem;font-size:0.875rem;font-weight:600;cursor:pointer;">
            Access Link
          </button>
        </form>
      </div>
    </div>
  `
%>
<%- include('../layouts/base', { title: 'Protected Link', body: pageBody, extraCss: '', extraJs: '' }) %>